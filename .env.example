# Meta AI Model API Key (from https://dev.meta.ai)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
CHAT_MODEL=muse-spark-1.3
VOICE_MODEL=muse-voice-transcribe-1.0

# Relational Database (PostgreSQL in production/Docker/Vercel; defaults to local SQLite if unset)
# For Vercel + Neon / Supabase (use the pooled connection string with ?sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/margin?sslmode=require
DATABASE_URL=

# Authentication & Security Secrets (Generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
ENV=development
JWT_SECRET_KEY=
PASSWORD_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MAX_SESSIONS_PER_USER=10

# Database Pool & Circuit Breaker Tuning
DB_POOL_MAX_SIZE=10
DB_CB_FAILURE_THRESHOLD=4
DB_CB_RECOVERY_TIMEOUT=30.0
DB_SLOW_QUERY_MS=500.0
